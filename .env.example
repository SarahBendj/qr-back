# App
PORT=5000
FRONTEND_URL=http://localhost:3001
HOST=https://smart-qr.pro
# Public API URL for one-click email links (defaults to HOST)
# API_PUBLIC_URL=https://api.smart-qr.pro
FRONTEND_BILLING_RETURN_URL=https://smart-qr.pro/settings/billing

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/smart_qr

# Auth
NEST_JWT_SECRET=
NEXTAUTH_SECRET=

# Stripe (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: Price IDs from Stripe Dashboard (Products → Prices)
STRIPE_PRICE_LITE=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_BUSINESS=price_...

# Optional: force Checkout payment methods (comma-separated)
# If unset, Stripe uses all methods enabled in your Dashboard (Klarna, Google Pay, cards, Link…)
# STRIPE_PAYMENT_METHODS=card,klarna,amazon_pay,link

# Resend (https://resend.com)
API_KEY_MAIL=re_...
# Until smart-qr.pro is verified in Resend → Domains, use:
# EMAIL_SENDER=onboarding@resend.dev
EMAIL_SENDER=contact@smart-qr.pro
BRAND_LOGO_URL=https://pub-36ea8e6f26f74e1c91f6de47f054dad7.r2.dev/smartQR/logo/logo.png
# Inbox for POST /contact (form → this address)
CONTACT_INBOX=contact@smart-qr.pro
