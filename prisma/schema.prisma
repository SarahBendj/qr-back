generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// ENUMS
//
enum PlanTier {
  LITE
  GROWTH
  BUSINESS
}

//
// USER
//
model User {
  id           String         @id @default(cuid())
  googleId     String?        @unique
  email        String         @unique
  name         String?
  picture      String?
  role         String         @default("user")
  /// Set only after successful Stripe subscription / plan payment
  plan         PlanTier?
  country      String?
  address      String?
  exceptionCode String?
  stripeCustomerId String?      @unique
  maxEventsOverride Int?
  maxGuestsOverride Int?
  maxEmailsOverride Int?

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  smartQrs       SmartQR[]
  events         Event[]
  refreshTokens  RefreshToken[]
  payment        Payment[]
  salonProfile   SalonProfile?
  
  notifications  Notification[]
}

/// White-label salon (Business / $70+): subdomain mark.smartqr.pro
model SalonProfile {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String   @unique
  /// Subdomain slug: grantee → grantee.smartqr.pro
  mark        String   @unique
  displayName String?
  tagline     String?
  aboutText   String?
  logoKey     String?
  faviconKey  String?
  bannerKeys  String[] @default([])
  accentColor  String?  @default("#a855f7")
  accentColor2 String?  @default("#ec4899")
  /// Premium page preset: dark | light
  pageTheme     String   @default("dark")
  referenceName String?
  contactEmails String[] @default([])
  footerAddress String?
  footerPhone   String?
  footerWebsite String?
  footerLegal   String?
  createdAt     DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([mark])
}



model SmartQR {
  id          String     @id @default(cuid())
  slug        String     @unique
  qrText      String
  x           Float
  y           Float
  size        Float
  pageCount   Int?        // ex: num pages dans le CV
  createdAt   DateTime    @default(now())

  user        User        @relation(fields: [userId], references: [id])
  userId      String
}




//
// NOTIFICATION (for candidate when recruiter cancels mission, etc.)
//
model Notification {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  type         String   // e.g. "mission_cancelled"
  title        String
  message      String
  justification String?
  missionId    String?
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())
}

//
// IDEA (Mind Trip)
//
model Idea {
  id          String     @id @default(cuid())

  title       String
  description String
  order       Int?

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

//
// EVENTS
//
model Event {
  id          String          @id @default(cuid())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  address     String?
  zipCode     String?
  city        String?
  country     String?
  latitude    Float?
  longitude   Float?
  title       String
  description String?
  location    String?
  category    String?
  date        DateTime?
  time        String?
  contact     String?
  isPrivate   Boolean         @default(false)
  isPrivatePaid Boolean       @default(false)
  eventImage  String?
  duration    String?
  mapUrl      String?
  capacity    String?
  slug        String          @unique
  accessCode  String?         @unique

  createdAt   DateTime        @default(now())

  links       EventLink[]
  tags        String[]
  instructions Instruction[] 
  price       String?
  participants Participant[]
  views        EventView[]
}

model EventView {
  id        String   @id @default(cuid())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  viewedAt  DateTime @default(now())
  source    String?

  @@index([eventId, viewedAt])
}

model Instruction {
  id      String @id @default(cuid())
  rule    String

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String
}

//
// EVENT LINKS
//
model EventLink {
  id        String   @id @default(cuid())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String

  title     String
  url       String
  order     Int?
}

//
// EVENT PARTICIPANTS
//
model Participant {
  id          String    @id @default(cuid())
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId     String

  name        String
  confirmed   Boolean   @default(false)
  declined    Boolean   @default(false)
  invitedAt   DateTime  @default(now())
  respondedAt DateTime?
  role        String
  email       String?
}

model Theme {
  id             String      @id @default(cuid())
  name           String      @unique
  bg             String
  mode           String 
  gradient       String
  text_primary   String
  text_secondary String

}


model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique 
  userId    String   
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PaymentType {
  
 event
}



model Payment {
  id                   String   @id @default(cuid())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String
  productId            String   @unique
  stripePaymentIntentId String?
  stripeSubscriptionId String?
  amount               Int
  currency             String
  type                 PaymentType
  status               String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  
  sessions             PaymentSession[] 
}

model PaymentSession {
  id               String    @id @default(cuid())
  payment          Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentId        String
  stripeSessionId  String    @unique
  status           String
  paidAt           DateTime?
  failedAt         DateTime?
  expiredAt        DateTime?
  type             PaymentType
  token            String    @unique @default(dbgenerated("gen_random_uuid()"))
  used             Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

/// Catalogue des offres (une ligne = un plan complet, features incluses)
model Plan {
  id            String   @id @default(cuid())
  tier          PlanTier @unique
  name          String
  description   String?
  price         Int
  currency      String   @default("EUR")
  interval      String   // month | year
  intervalCount Int      @default(1)
  maxEvents     Int?     @default(1)
  maxGuests     Int?     @default(50)
  maxEmails     Int?     @default(100)
  discount      Int?     // % optionnel
  features      String[] // ex: ["Portfolio", "QR illimité", "Événements privés"]
  stripePriceId String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
